# Leave DATABASE_URL unset locally: the app uses PGlite in ./data/pglite.
# Hosted: a Supabase Postgres connection string (pooled, port 6543, for the running app;
# the direct one, port 5432, for `npm run db:migrate`).
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
